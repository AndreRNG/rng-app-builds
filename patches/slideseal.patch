index a861862..20716a9 100644
--- a/packaging/linux/flatpak/ai.storyteller.deckcraft.bundle.yml
+++ b/packaging/linux/flatpak/media.rng.deckduck.bundle.yml
@@ -9,17 +9,16 @@
 # and load X11, Wayland, xkbcommon, Vulkan and ALSA at runtime; the freedesktop runtime has all
 # of them, and the GPU driver comes from its org.freedesktop.Platform.GL extension.
 #
-# ai.storyteller.deckcraft.yml (same directory) is the from-source manifest for Flathub. Keep
+# media.rng.deckduck.yml (same directory) is the from-source manifest for Flathub. Keep
 # runtime-version and finish-args identical in both (packaging-lint checks this).
-id: ai.storyteller.deckcraft
+id: media.rng.deckduck
 runtime: org.freedesktop.Platform
 runtime-version: '25.08'
 sdk: org.freedesktop.Sdk
 command: deckcraft
 finish-args:
-  # The shared updater inspects and updates this installation via flatpak-spawn --host.
-  - --talk-name=org.freedesktop.Flatpak
-  - --filesystem=xdg-data/ArtCraft/versions:ro
+  # RNG patch (DeckDuck): no self-update, so no host-spawn (org.freedesktop.Flatpak) and no
+  # launcher-versions access.
   # Display: Wayland first; X11 only when no Wayland compositor is running.
   - --socket=wayland
   - --socket=fallback-x11
@@ -34,20 +33,19 @@ finish-args:
   # document portal, so picked files work anywhere without broad filesystem access. Documents is
   # granted so decks passed by path (the command line, Open Recent) work in the usual place.
   - --filesystem=xdg-documents
-  # Network: update checks reach GitHub. The optional --control server still listens on 127.0.0.1
-  # only. Home/host filesystem access is deliberately not granted.
-  - --share=network
+  # RNG patch (DeckDuck): no network permission at all (no update checks). The optional --control
+  # server listens on 127.0.0.1 only. Home/host filesystem access is deliberately not granted.
 modules:
   - name: deckcraft
     buildsystem: simple
     build-commands:
       - install -Dm755 bin/deckcraft /app/bin/deckcraft
       - install -Dm755 bin/deckcraft-cli /app/bin/deckcraft-cli
-      - install -Dm644 share/applications/ai.storyteller.deckcraft.desktop /app/share/applications/ai.storyteller.deckcraft.desktop
+      - install -Dm644 share/applications/media.rng.deckduck.desktop /app/share/applications/media.rng.deckduck.desktop
       # .deckcraft; the runtime's shared-mime-info already knows the PowerPoint types.
-      - install -Dm644 share/mime/packages/ai.storyteller.deckcraft.xml /app/share/mime/packages/ai.storyteller.deckcraft.xml
+      - install -Dm644 share/mime/packages/media.rng.deckduck.xml /app/share/mime/packages/media.rng.deckduck.xml
       # Already has the release's version and date substituted by package.sh.
-      - install -Dm644 share/metainfo/ai.storyteller.deckcraft.metainfo.xml /app/share/metainfo/ai.storyteller.deckcraft.metainfo.xml
+      - install -Dm644 share/metainfo/media.rng.deckduck.metainfo.xml /app/share/metainfo/media.rng.deckduck.metainfo.xml
       - mkdir -p /app/share/icons /app/share/doc && cp -R share/icons/hicolor /app/share/icons/ && cp -R share/doc/deckcraft /app/share/doc/
     sources:
       - type: dir
