+/// The built-in theme (and its colour / effect scheme) is stored in files as "DeckCraft", which
+/// stays so saved decks and golden fixtures keep their bytes; people see it as "DeckDuck".
+const STORED_THEME_NAME: &str = "DeckCraft";
+const SHOWN_THEME_NAME: &str = "DeckDuck";
+
+/// The name to show for a built-in theme / scheme name: "DeckCraft" reads "DeckDuck".
+pub fn theme_display_name(name: &str) -> &str {
+    if name == STORED_THEME_NAME { SHOWN_THEME_NAME } else { name }
+}
+
+/// The name a theme / scheme is stored and looked up under: "DeckDuck" (what people see and may
+/// type) maps back to "DeckCraft", which files already hold.
+pub fn theme_stored_name(name: &str) -> &str {
+    if name.eq_ignore_ascii_case(SHOWN_THEME_NAME) { STORED_THEME_NAME } else { name }
+}
