diff --git a/Cargo.lock b/Cargo.lock
index 6f75855..83febdf 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -1418,6 +1418,7 @@ dependencies = [
  "egui",
  "egui_extras",
  "egui_kittest",
+ "image",
  "log",
  "serde",
  "serde_json",
diff --git a/apps/deckcraft/src/main.rs b/apps/deckcraft/src/main.rs
index d71817c..0f17b50 100644
--- a/apps/deckcraft/src/main.rs
+++ b/apps/deckcraft/src/main.rs
@@ -240,7 +240,7 @@ fn main() -> eframe::Result {
     }
     let mut options = eframe::NativeOptions {
         viewport: egui::ViewportBuilder::default()
-            .with_title("DeckCraft")
+            .with_title("DeckDuck")
             .with_inner_size([1440.0, 900.0])
             .with_min_inner_size([900.0, 560.0])
             .with_drag_and_drop(true)
@@ -297,7 +297,8 @@ fn main() -> eframe::Result {
                 app.services.displays = Some(Box::new(move || display_count(&window)));
             }
             load_prefs(&mut app);
-            app.enable_update_checks();
+            // RNG patch (DeckDuck): no upstream self-update (it would replace DeckDuck with plain
+            // DeckCraft); DeckDuck updates via ~/.local/bin/update-rng-app deckduck
             // AutoRecover: reopen what a previous run left unsaved, then keep it current.
             if std::env::var_os("DECKCRAFT_NO_RECOVERY").is_none() {
                 app.session.recovery_dir = deckcraft_engine::recovery::default_dir();
