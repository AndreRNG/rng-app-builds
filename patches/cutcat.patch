new file mode 100644
index 00000000..b5a09769
--- /dev/null
+++ b/crates/ui-egui/src/panels/timeline/fades.rs
@@ -0,0 +1,139 @@
+//! RNG patch (CutCat): fade handles on the top corners of clips, as in DaVinci Resolve and Final
+//! Cut. Dragging one inwards puts a fade (the default transition) on that edge of the clip: a
+//! crossfade when another clip touches it there, a fade from / to nothing otherwise. The drag
+//! then goes on as an ordinary transition-duration drag, so it snaps, previews and undoes like one.
+
+use egui::{Color32, CursorIcon, Pos2, Rect, Stroke, pos2, vec2};
+use filmcraft_edit::Edge;
+use filmcraft_project::{ClipId, Sequence, TrackKind, TransitionId};
+use filmcraft_time::Tick;
+use serde_json::json;
+
+use super::{Drag, FilmcraftApp, Layout};
+use crate::theme::Tokens;
+
+/// The handle's size (points) and the narrowest clip that shows handles.
+const SIZE: f32 = 10.0;
+const MIN_CLIP_W: f32 = 36.0;
+
+/// A fade handle: the clip, which edge of it, and the kind of track it is on.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) struct Handle {
+    pub clip: ClipId,
+    pub edge: Edge,
+    pub kind: TrackKind,
+    pub rect: Rect,
+}
+
+/// The handles of the clip under `p` (its two top corners), on an unlocked track.
+fn handles_near(seq: &Sequence, layout: &Layout, p: Pos2) -> Vec<Handle> {
+    let Some(row) = layout.row_at(p.y) else { return Vec::new() };
+    let shown = layout.shown(row);
+    let Some(track) = seq.tracks(row.kind).iter().find(|t| t.id == row.track) else { return Vec::new() };
+    if track.locked || shown.height() < SIZE * 2.0 {
+        return Vec::new();
+    }
+    let Some(it) = track.items.iter().find(|it| {
+        let (x0, x1) = (layout.x_of(it.start), layout.x_of(it.end()));
+        x0 <= p.x && p.x <= x1 && x1 - x0 >= MIN_CLIP_W
+    }) else {
+        return Vec::new();
+    };
+    let (x0, x1) = (layout.x_of(it.start), layout.x_of(it.end()));
+    let top = row.rect.min.y + 1.0;
+    let left = Rect::from_min_size(pos2(x0 + 1.0, top), vec2(SIZE, SIZE));
+    let right = Rect::from_min_size(pos2(x1 - 1.0 - SIZE, top), vec2(SIZE, SIZE));
+    [(Edge::In, left), (Edge::Out, right)]
+        .into_iter()
+        .filter(|(_, r)| shown.contains(r.center()) && layout.content.contains(r.center()))
+        .map(|(edge, rect)| Handle { clip: it.id, edge, kind: row.kind, rect })
+        .collect()
+}
+
+/// The fade handle exactly under `p` (with a little slack for small handles).
+pub(super) fn handle_at(seq: &Sequence, layout: &Layout, p: Pos2) -> Option<Handle> {
+    handles_near(seq, layout, p).into_iter().find(|h| h.rect.expand(3.0).contains(p))
+}
+
+/// Draw the handles of the clip under the pointer (only there, to keep the Timeline clean).
+pub(super) fn paint(ui: &egui::Ui, seq: &Sequence, layout: &Layout, t: &Tokens, dragging: bool) {
+    if dragging {
+        return;
+    }
+    let Some(p) = ui.ctx().pointer_hover_pos() else { return };
+    let hot = handle_at(seq, layout, p);
+    let painter = ui.painter().with_clip_rect(layout.content);
+    for h in handles_near(seq, layout, p) {
+        let on = hot == Some(h);
+        // a quarter-round tab tucked into the clip's corner, the curved side facing inwards
+        let r = h.rect;
+        let fill = if on { Color32::WHITE } else { Color32::from_white_alpha(200) };
+        let pts: Vec<Pos2> = match h.edge {
+            Edge::In => vec![r.left_top(), r.right_top(), r.left_bottom()],
+            Edge::Out => vec![r.left_top(), r.right_top(), r.right_bottom()],
+        };
+        painter.add(egui::Shape::convex_polygon(pts, fill, Stroke::new(1.0, Color32::from_black_alpha(140))));
+        if on {
+            ui.ctx().set_cursor_icon(CursorIcon::ResizeColumn);
+            let _ = t;
+        }
+    }
+}
+
+/// The transition already on `edge` of `clip`, if any (its id, start and duration).
+fn existing(seq: &Sequence, clip: ClipId, edge: Edge) -> Option<(TransitionId, Tick, Tick)> {
+    seq.all_tracks().find_map(|tr| {
+        let it = tr.items.iter().find(|it| it.id == clip)?;
+        let cut = if edge == Edge::In { it.start } else { it.end() };
+        tr.transitions.iter().find(|x| x.start <= cut && cut <= x.start + x.duration).map(|x| (x.id, x.start, x.duration))
+    })
+}
+
+/// Start a fade drag on `h`: reuse the transition already on that edge or add a one-frame one,
+/// then hand over to [`Drag::Transition`] on its inner end. `t` is the pointer's time.
+pub(super) fn start(app: &mut FilmcraftApp, ctx: &egui::Context, h: Handle, t: Tick) -> Option<Drag> {
+    // the inner end moves: a fade at the clip's start grows to the right, at its end to the left
+    let inner = if h.edge == Edge::In { Edge::Out } else { Edge::In };
+    let seq = app.session.active_sequence()?;
+    if let Some((id, start, duration)) = existing(seq, h.clip, h.edge) {
+        return Some(Drag::Transition { id, edge: Some(inner), from: t, start, duration });
+    }
+    let undo_before = app.session.history.undo.len();
+    let cmd = if h.kind == TrackKind::Video { "sequence.applyVideoTransition" } else { "sequence.applyAudioTransition" };
+    let (edge, align) = if h.edge == Edge::In { ("in", "start") } else { ("out", "end") };
+    let mut r = app.session.execute(cmd, json!({"clip": h.clip.0, "edge": edge, "frames": 1, "align": align}));
+    if r.is_err() {
+        // no media past the cut for a one-sided start/end: centre it on the cut instead
+        r = app.session.execute(cmd, json!({"clip": h.clip.0, "edge": edge, "frames": 2}));
+    }
+    match r {
+        Ok(_) => {
+            ctx.data_mut(|d| d.insert_temp(undo_id(), undo_before));
+            let seq = app.session.active_sequence()?;
+            existing(seq, h.clip, h.edge).map(|(id, start, duration)| Drag::Transition { id, edge: Some(inner), from: t, start, duration })
+        }
+        Err(e) => {
+            app.ui.status = e.to_string();
+            None
+        }
+    }
+}
+
+fn undo_id() -> egui::Id {
+    egui::Id::new("cutcat-fade-undo")
+}
+
+/// After a fade drag is released: the transition it added and the resize that followed become one
+/// undo step ("Add Fade").
+pub(super) fn squash_undo(app: &mut FilmcraftApp, ctx: &egui::Context) {
+    let Some(before) = ctx.data_mut(|d| d.remove_temp::<usize>(undo_id())) else { return };
+    let undo = &mut app.session.history.undo;
+    if undo.len() == before + 2 {
+        undo.pop();
+    }
+    if undo.len() == before + 1
+        && let Some(top) = undo.last_mut()
+    {
+        top.0 = "Add Fade".into();
+    }
+}
