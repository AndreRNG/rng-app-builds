+
+/// The icon's texture, decoded once per context; `None` for icons drawn in code.
+pub fn texture(ctx: &egui::Context, icon: Icon) -> Option<egui::TextureHandle> {
+    let id = egui::Id::new(("cutcat-tabler", icon));
+    if let Some(t) = ctx.data(|d| d.get_temp::<Option<egui::TextureHandle>>(id)) {
+        return t;
+    }
+    let tex = png(icon).and_then(|bytes| {
+        let img = image::load_from_memory_with_format(bytes, image::ImageFormat::Png).ok()?.to_rgba8();
+        let color = egui::ColorImage::from_rgba_unmultiplied([img.width() as usize, img.height() as usize], img.as_raw());
+        let opts = egui::TextureOptions { mipmap_mode: Some(egui::TextureFilter::Linear), ..egui::TextureOptions::LINEAR };
+        Some(ctx.load_texture(format!("tabler-{icon:?}"), color, opts))
+    });
+    ctx.data_mut(|d| d.insert_temp(id, tex.clone()));
+    tex
+}
