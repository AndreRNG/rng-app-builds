diff --git a/apps/wordcraft/src/main.rs b/apps/wordcraft/src/main.rs
index 7f81caa..7858b5e 100644
--- a/apps/wordcraft/src/main.rs
+++ b/apps/wordcraft/src/main.rs
@@ -646,7 +646,7 @@ fn main() -> eframe::Result {
     }
     let mut options = eframe::NativeOptions {
         viewport: egui::ViewportBuilder::default()
-            .with_title("WordCraft")
+            .with_title("DocDog")
             .with_app_id("ai.storyteller.wordcraft")
             .with_inner_size([1440.0, 920.0])
             .with_min_inner_size([760.0, 480.0])
@@ -713,7 +713,9 @@ fn main() -> eframe::Result {
             let mut session = Session::new(doc);
             session.system_region = region;
             let mut app = WordApp::new(session, services(file_dialog, cancel_file_dialog, &cc.egui_ctx));
-            app.set_startup_update_check(true);
+            // RNG patch (DocDog): no upstream self-update (it would replace DocDog with plain
+            // WordCraft); DocDog updates via ~/.local/bin/update-rng-app docdog
+            app.set_startup_update_check(false);
             load_prefs(&mut app);
             // After the preferences, so the reason it gives is in the interface language.
             if updates_unsafe {
