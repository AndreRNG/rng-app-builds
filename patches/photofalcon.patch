diff --git a/apps/photocraft/src/main.rs b/apps/photocraft/src/main.rs
index dbde20d44..07983f356 100644
--- a/apps/photocraft/src/main.rs
+++ b/apps/photocraft/src/main.rs
@@ -178,7 +178,7 @@ fn native_options(custom_titlebar: bool) -> eframe::NativeOptions {
     eframe::NativeOptions {
         viewport: viewport
             .with_app_id(APP_ID)
-            .with_title("PhotoCraft")
+            .with_title("PhotoFox")
             .with_inner_size([1440.0, 900.0])
             .with_min_inner_size(photocraft_ui_egui::MIN_WINDOW_SIZE)
             .with_drag_and_drop(true)
diff --git a/apps/photocraft/src/services.rs b/apps/photocraft/src/services.rs
index 352321d29..f8ef73980 100644
--- a/apps/photocraft/src/services.rs
+++ b/apps/photocraft/src/services.rs
@@ -792,7 +792,9 @@ pub fn native(automation: Option<photocraft_automation::AuthorizedWorkspace>) ->
         inbox: None,
         open_url: Some(Box::new(|url: &str| open::that(url).map_err(|e| e.to_string()))),
         beep: Some(platform_beep),
-        check_updates: Some(crate::updates::service()),
+        // RNG patch (PhotoFox): no upstream self-update (it would replace PhotoFox with plain
+        // PhotoCraft); PhotoFox updates via ~/.local/bin/update-rng-app photofox
+        check_updates: None,
         last_update: Some(crate::updates::last_update),
         clipboard_set_image: Some({
             let clip = clip.clone();
diff --git a/apps/photocraft/src/updates.rs b/apps/photocraft/src/updates.rs
index 50bba88de..c7d1953a9 100644
--- a/apps/photocraft/src/updates.rs
+++ b/apps/photocraft/src/updates.rs
@@ -3,6 +3,7 @@
 
 use photocraft_engine::updates_cmds::{CheckFn, CheckResult, Release};
 
+#[allow(dead_code)] // RNG patch (PhotoFox): the upstream self-update is unplugged
 pub fn service() -> CheckFn {
     Box::new(|| {
         let (tx, rx) = std::sync::mpsc::channel();
@@ -33,6 +34,7 @@ pub fn last_update() -> Option<Result<String, String>> {
     }
 }
 
+#[allow(dead_code)]
 fn check() -> CheckResult {
     let http = craft_update::Http::new("PhotoCraft/Update")?;
     let found = craft_update::check_for_update(&photocraft_ui_egui::UPDATE_APP, &http, photocraft_engine::build_info::VERSION)?;
