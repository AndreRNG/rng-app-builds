+/// RNG patch (PhotoFox): the upstream catalogs (and some English strings) say "PhotoCraft"; every
+/// string shown to the user says "PhotoFox" instead. Rewritten strings are cached (leaked once).
+fn rebrand(s: &str) -> &str {
+    if !s.contains("PhotoCraft") {
+        return s;
+    }
+    static CACHE: LazyLock<std::sync::Mutex<HashMap<String, &'static str>>> = LazyLock::new(Default::default);
+    let mut cache = CACHE.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some(done) = cache.get(s) {
+        return *done;
+    }
+    let done: &'static str = Box::leak(s.replace("PhotoCraft", "PhotoFox").into_boxed_str());
+    cache.insert(s.to_owned(), done);
+    done
 }
 
