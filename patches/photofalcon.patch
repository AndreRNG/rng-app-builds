     assert!(content.contains("/ActualText <FEFF0041000A"), "the first span carries the break:\n{content}");
 }
@@ -854,3 +854,18 @@ fn seven_us_letter_artboards_export_without_a_false_memory_limit() {
     let parsed = lopdf::Document::load_mem(&out.bytes).unwrap();
     assert_eq!(parsed.get_pages().len(), 7);
 }
+
+/// Page 1's text as a PDF reader selects it. lopdf 0.42+ decodes a simple font through its
+/// /Encoding glyph names before /ToUnicode, so the selection font's `c1`, `c2`… names read as
+/// nothing; readers such as Poppler use /ToUnicode first, so drop /Encoding where one exists.
+fn selectable_text(parsed: &lopdf::Document) -> String {
+    let mut doc = parsed.clone();
+    for obj in doc.objects.values_mut() {
+        if let Ok(dict) = obj.as_dict_mut() {
+            if dict.has(b"ToUnicode") && dict.get(b"Type").and_then(|t| t.as_name()).is_ok_and(|t| t == b"Font") {
+                dict.remove(b"Encoding");
+            }
+        }
+    }
+    doc.extract_text(&[1]).unwrap()
+}
